<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Báo Cáo Minh Chứng TK-04 (T05F92B) — Kiểm Thử UX & Responsive</title>
  <style>
    :root {
      --primary: #206d53;
      --primary-light: #e6eedc;
      --accent: #d9edb5;
      --dark: #122b29;
      --ink: #1d3530;
      --muted: #586861;
      --line: #d8e0d7;
      --bg: #f8faf7;
      --card-bg: #ffffff;
      --success: #2e7d32;
      --warn: #ed6c02;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: var(--ink);
      background: var(--bg);
      line-height: 1.6;
      padding: 30px 20px;
    }
    .container {
      max-width: 1040px;
      margin: 0 auto;
      background: var(--card-bg);
      padding: 45px;
      border-radius: 14px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
      border: 1px solid var(--line);
    }
    header {
      border-bottom: 2px solid var(--primary);
      padding-bottom: 24px;
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
    }
    h1 {
      font-size: 26px;
      color: var(--dark);
      font-weight: 750;
      letter-spacing: -0.5px;
      line-height: 1.3;
    }
    .badge {
      display: inline-block;
      background: var(--primary);
      color: white;
      font-size: 12px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 20px;
      margin-top: 6px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    .print-btn {
      background: var(--primary);
      color: white;
      border: none;
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .print-btn:hover { background: #164f3c; }
    .meta-box {
      background: var(--primary-light);
      border-left: 4px solid var(--primary);
      padding: 16px 20px;
      border-radius: 0 10px 10px 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 30px;
      font-size: 13.5px;
    }
    .meta-item strong { color: var(--dark); }
    h2 {
      font-size: 19px;
      color: var(--primary);
      margin: 32px 0 16px;
      display: flex;
      align-items: center;
      gap: 8px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 8px;
    }
    h3 {
      font-size: 15px;
      color: var(--dark);
      margin: 18px 0 10px;
    }
    p, li { font-size: 14px; color: var(--ink); }
    ul, ol { padding-left: 22px; margin-bottom: 14px; }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0 24px;
      font-size: 13px;
    }
    th, td {
      border: 1px solid var(--line);
      padding: 10px 14px;
      text-align: left;
    }
    th {
      background: #f1f5ee;
      color: var(--dark);
      font-weight: 650;
    }
    tr:nth-child(even) { background: #fafcf9; }
    .status-pass {
      color: var(--success);
      font-weight: 650;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .status-merged {
      background: #e8f5e9;
      color: var(--success);
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 12px;
    }
    .code-box {
      background: #202b28;
      color: #e4efe7;
      padding: 14px 18px;
      border-radius: 8px;
      font-family: Consolas, Monaco, monospace;
      font-size: 12.5px;
      line-height: 1.5;
      overflow-x: auto;
      margin: 12px 0 20px;
    }
    .code-add { color: #86efac; }
    .code-del { color: #fca5a5; }
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 20px;
      margin: 20px 0;
    }
    .gallery-item {
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      background: white;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      display: flex;
      flex-direction: column;
    }
    .gallery-item img {
      width: 100%;
      height: auto;
      display: block;
      border-bottom: 1px solid var(--line);
      background: #f3f3f3;
    }
    .gallery-caption {
      padding: 12px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--dark);
      background: #fbfdfa;
      flex-grow: 1;
    }
    .gallery-caption small {
      display: block;
      color: var(--muted);
      font-weight: normal;
      margin-top: 4px;
      font-size: 11px;
    }
    .summary-card {
      background: #f2f7ef;
      border-radius: 10px;
      padding: 20px;
      margin: 20px 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      text-align: center;
    }
    .summary-card .num {
      font-size: 28px;
      font-weight: 750;
      color: var(--primary);
    }
    .summary-card .lbl {
      font-size: 12px;
      color: var(--muted);
      text-transform: uppercase;
      font-weight: 600;
    }
    footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
      font-size: 12px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    @media print {
      body { background: white; padding: 0; }
      .container { box-shadow: none; border: none; padding: 15px; }
      .print-btn { display: none; }
      .gallery { grid-template-columns: repeat(2, 1fr); page-break-inside: avoid; }
    }
  </style>
</head>
<body>

<div class="container">
